# Copy this file to `.env.development` and fill in your own values.
# `.env.development` is gitignored by design.

# Dev server remote access, only needed for `npm run dev -- --host`.
# VITE_ALLOWED_HOST_REMOTE_IP=a.b.c.d
# VITE_ALLOWED_HOST_REMOTE_DNS=your.dns

# OpenRouter API key, local only, never shipped. See README.md.
# VITE_OPENROUTER_API_KEY=sk-or-v1-your-key
